{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v grepum >/dev/null 2>&1 && grepum summary 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
